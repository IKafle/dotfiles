/* rofi config, passed explicitly by tools/rofi-launcher.sh (-config).
 * Nothing is written to ~/.config/rofi: this file is the truth.
 * DPI is not set here — the launcher reads it from GNOME (Xft.dpi) at run time. */
configuration {
    modes:               "drun,run,window";
    show-icons:          true;
    icon-theme:          "Yaru";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    drun-display-format: "{name}";
    font:                "JetBrains Mono 12";
    matching:            "fuzzy";
    sort:                true;
    click-to-exit:       true;
}

@theme "Arc-Dark"

window {
    width:   40%;
    padding: 12px;
}
listview {
    lines:   9;
    spacing: 4px;
}
element {
    padding: 6px 8px;
}
element-icon {
    size: 1.4em;
}
inputbar {
    padding: 6px;
}
