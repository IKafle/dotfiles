#!/usr/bin/env bash
# bx pre-push: instant, advisory, never blocks. Says whether HEAD has passed
# `bx run bootstrap-smoke` (a green run stamps .git/bx-smoked). The smoke
# itself is minutes in a docker container, so it runs on demand, not here
# (docs/adr/0006).
set -uo pipefail
head=$(git rev-parse HEAD)
stamp="$(git rev-parse --git-dir)/bx-smoked"
if [[ -f "$stamp" && "$(<"$stamp")" == "$head" ]]; then
    printf '\033[32m✔ pre-push: %s bootstrapped a fresh machine green\033[0m\n' "${head:0:7}" >&2
else
    printf '\033[33m⚠ pre-push: %s has not been smoke-tested — run: bx run bootstrap-smoke (when bootstrap/config/init.sh changed)\033[0m\n' "${head:0:7}" >&2
fi
exit 0
