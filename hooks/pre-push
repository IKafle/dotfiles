#!/usr/bin/env bash
# bx pre-push: prove HEAD bootstraps a fresh Ubuntu before it leaves this
# machine. Replaces CI (docs/adr/0006): the only check that catches "it worked
# here because this laptop already had it". Takes a few minutes and needs the
# docker daemon. A green run records its commit in .git/bx-smoked so an
# unchanged HEAD is not smoked twice; BX_SMOKE_FORCE=1 reruns anyway.
# Bypass only with a reason: git push --no-verify
set -uo pipefail
BX_HOME=$(git rev-parse --show-toplevel)
export BX_HOME
head=$(git rev-parse HEAD)
stamp="$(git rev-parse --git-dir)/bx-smoked"
printf '\n── pre-push: bootstrap-smoke ──\n' >&2
if [[ -z "${BX_SMOKE_FORCE:-}" && -f "$stamp" && "$(<"$stamp")" == "$head" ]]; then
    printf '  skip: %s already bootstrapped green (BX_SMOKE_FORCE=1 to rerun)\n' "${head:0:7}" >&2
    exit 0
fi
if bash "$BX_HOME/tools/bootstrap-smoke.sh"; then
    printf '%s\n' "$head" > "$stamp"
    printf '\033[32m✔ pre-push: fresh machine bootstraps green\033[0m\n' >&2
else
    printf '\n\033[31m✘ push blocked — HEAD does not bootstrap a fresh machine (see above)\033[0m\n' >&2
    exit 1
fi
